
@table(Name, NeedsParam, Tag, Description, Key, Control, Shift, Alt)
CommandsTable:
{
 { None,                       false, "",       "Null Command",                   None  0 0 0 }
 //- App
 { SetFontSize,                true,  "App",    "Set font size",                  None  0 0 0 }
 { SelectInputDevice,          true,  "App",    "Select MIDI input device",       None  0 0 0 }
 { SelectOutputDevice,         true,  "App",    "Select MIDI output device",      None  0 0 0 }
 { SelectInstrument,           true,  "App",    "Select Synth output instrument", None  0 0 0 }
 { ToggleMIDIInput,            false, "App",    "Toggle MIDI input",              None  0 0 0 }
 { ToggleMIDIOutput,           false, "App",    "Toggle MIDI output",             None  0 0 0 }
 { ToggleVirtualKeyboardInput, false, "App",    "Toggle Virtual Keyboard input",  None  0 0 0 }
 { ToggleSynthOutput,          false, "App",    "Toggle Synth output",            None  0 0 0 } 
 //- Panels 
 { ClosePanel,                 false, "Panel",  "Close",                          P     1 1 0 }  
 { SplitSelectedPanelX,        false, "Panel",  "Split on X axis",                P     1 0 0 }
 { SplitSelectedPanelY,        false, "Panel",  "Split on Y axis",                Minus 1 0 0 }
 { SelectNextPanel,            false, "Panel",  "Select next",                    Comma 1 0 0 }
 { SetPanelType,               true,  "Panel",  "Set type",                       T     1 0 0 }
 //- Piece 
 { PieceToggleRecording,       false, "Piece",  "Toggle recording",               Space 0 0 0 }
 { PieceTogglePlaying,         false, "Piece",  "Toggle playing",                 None  0 0 0 }
 { PieceStartPlaying,          false, "Piece",  "Start playing",                  None  0 0 0 }
 { PieceStopPlaying,           false, "Piece",  "Stop playing",                   None  0 0 0 }
 { PieceTogglePracticing,      false, "Piece",  "Toggle practicing",              None  0 0 0 }
 { PieceStop,                  false, "Piece",  "Stop",                          None  0 0 0 }
 { PieceClear,                 false, "Piece",  "Clear",                          None  0 0 0 }
 { PieceToggleMetronome,       false, "Piece",  "Toggle metronome",               None  0 0 0 }
 { PieceToggleBarWrapping,     false, "Piece",  "Toggle bar wrapping",            None  0 0 0 }
 { PieceToggleStrictTiming,    false, "Piece",  "Toggle strict timing practice",  None  0 0 0 }
 { PieceToggleLooping,         false, "Piece",  "Toggle looping",                 None  0 0 0 }
 { PieceSetBPM,                true,  "Piece",  "Set BPM",                        None  0 0 0 }
 { PieceSelectNote,            true,  "Piece",  "Select note",                    None  0 0 0 }
 { PieceDeselectNote,          false, "Piece",  "Deselect note",                  None  0 0 0 }
 { PieceDeleteNote,            false, "Piece",  "Delete note",                    None  0 0 0 }
 { PieceSetNoteLength,         false, "Piece",  "Set note length",                None  0 0 0 }
 { PieceSelectInstrument,      false, "Piece",  "Select instrument",              S     1 0 0 }
 { PieceAddStaff,              false, "Piece",  "Add staff octave below",         None  0 0 0 }
 { PieceTrimAtFirstNote,       false, "Piece",  "Trim piece start at first note", None  0 0 0 }
 //- Lister
 { CloseLister,                false, "Lister", "Close",                          None  0 0 0 }
 { OpenLister,                 true,  "Lister", "Open",                           None  0 0 0 } 
}

//- Commands 

@data_enum("command_kind")
CommandKind:
{
 @expand(CommandsTable)
  ```Command_$(Name),
 ```;
 `Command_Count`;
}

@data_table("str8")
CommandsDescriptions:
{
 @expand(CommandsTable) @strings
  ```{$(Description)},
 ```;
}

@data_table("str8")
CommandsTags:
{
 @expand(CommandsTable) @strings
  ```{$(Tag)},
 ```;
}

@data_table("command_kind")
CommandsWithoutParam:
{
 @expand(CommandsTable)
  ```Command_$(Name),
 ```;
}

@data_table("b32")
CommandHasParam:
{
 @expand(CommandsTable)
  ```$(NeedsParam),
 ```;
}


@data
{
 ```
  typedef struct key_bind key_bind;
 struct key_bind
 {
  b32 Control;
  b32 Shift;
  b32 Alt;
  platform_key Key;
  
  command_kind Command;
 };
 ```;
}

@data_table("key_bind")
DefaultKeyBinds:
{
 @expand(CommandsTable)
  ```
 {
  .Shift = $(Shift), .Control = $(Control), .Alt = $(Alt),
  .Key = PlatformKey_$(Key),
  .Command = Command_$(Name),
 },```;
}

//- Panels 

@table(Name, DisplayName)
PanelTypes:
{
 { Empty,    "Empty"    }
 { Piece,    "Piece"    }
 { Controls, "Controls" }
 { Debug,    "Debug"    }
 { Piano,    "Piano"    }
}

@data_enum("panel_kind")
PanelKind:
{
 @expand(PanelTypes)
  ```PanelKind_$(Name),
 ```;
 `PanelKind_Count`;
}

@data_table("str8")
PanelTypeStrings: 
{
 @expand(PanelTypes) @strings
  `{$(DisplayName)},`;
}
