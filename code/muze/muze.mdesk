//- Commands 

@data_enum("command_kind")
CommandKind:
{
 @expand(CommandsTable)
  ```Command_$(Name),
 ```;
 `Command_Count`;
}

@data
{
 ```
  typedef struct command_meta_info command_meta_info;
 struct command_meta_info
 {
  command_kind Command;
  b32 NeedsParam;
  
  b32 PieceUndoable;
  
  str8 Tag;
  str8 Description;
  
  b32 Control;
  b32 Shift;
  b32 Alt;
  platform_key Key;
  
  f32 Min;
  f32 Max;
  f32 Step;
  str8 SliderFmt;
 };
 ```;
}

@data_table("command_meta_info")
CommandsMetaInfo:
{
 @expand(CommandsTable) @strings
  ```
 {
  .Command = Command_$(Name),
  .NeedsParam = $(NeedsParam),
  
  .PieceUndoable = $(PieceUndoable),
  
  .Tag = {$(Tag)},
  .Description = {$(Description)},
  
  .Key = PlatformKey_$(Key),
  .Shift = $(Shift),
  .Control = $(Control),
  .Alt = $(Alt),
  
  .Min = $(Min),
  .Max = $(Max),
  .Step = $(Step),
  
  .SliderFmt = {$(SliderFmt)},
 },
 ```
}

//- Panels 

@table(Name, DisplayName)
PanelTypes:
{
 { Empty,    "Empty"    }
 { Debug,    "Debug"    }
 { Piece,    "Piece"    }
 { Controls, "Controls" }
 { Piano,    "Piano"    }
}

@data_enum("panel_kind")
PanelKind:
{
 @expand(PanelTypes)
  ```PanelKind_$(Name),
 ```;
 `PanelKind_Count`;
}

@data_table("str8")
PanelTypeStrings: 
{
 @expand(PanelTypes) @strings
  `{$(DisplayName)},`;
}
