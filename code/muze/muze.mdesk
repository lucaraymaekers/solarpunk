@table(Name, DisplayName)
PanelTypes:
{
 { Empty,    "Empty"          }
 { Sheet,    "Sheet"          }    
 { Roll,     "Roll"           }
 { Controls, "Sheet controls" }
 { Piece,    "Piece"          }
 { Debug,    "Debug"          }
}

@table
Keys:
{
 { Note_C 0 }
 {          }
}

@data_enum("panel_kind")
PanelKind:
{
 @expand(PanelTypes)
  ```PanelKind_$(Name),
 ```;
 `PanelKind_Count`;
}

@data_table("str8")
PanelTypeStrings: 
{
 @expand(PanelTypes) @strings
  `{$(DisplayName)},`;
}
