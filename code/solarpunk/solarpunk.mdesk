//~ Products
@table(Kind, Name)
ProductsTable:
{
 { None        "None"         }
 { Apples      "Apples"       }
 { Pears       "Pears"        }
 { Cabbage     "Cabbage"      }
 { Carrots     "Carrots"      }
 { Wheat       "Wheat"        }
 { Fish        "Fish"         }
 { Meat        "Meat"         }
 { Eggs        "Eggs"         }
}

@data_enum("product_kind")
{
 @expand(ProductsTable)
  ```ProductKind_$(Kind),
 ```;
 `ProductKind_Count`;
}

@data_table("str8")
ProductNames:
{
 @expand(ProductsTable) @strings
  ```{$(Name)},
 ```;
}
