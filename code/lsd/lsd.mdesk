@table(Name, Byte, Description)
LSD_Commands:
{
 { None         "\0" "Nothing"                                          }
 { Interrogate  "\0"  "Connect to loader"                                }
 { EraseAll     "A"  "Erase Flash/EE program and data memory"           }
 { Program      "W"  "Progam block of Flash/EE program memory"          }
 { ChangeBaud   "B"  "Change Baud Rate"                                 }
 { Run          "U"  "Jump to User Code"                                }
 { PageDownload "Q"  "Page Download" }
}

@data_enum("command_kind")
{
 @expand(LSD_Commands)
  ```CommandKind_$(Name),
 ```;
 `CommandKind_Count`;
}

@data_table("str8")
CommandDescriptions:
{
 @expand(LSD_Commands) @strings
  `{$(Description)},`;
};

@data_table("u8")
CommandBytes:
{
 @expand(LSD_Commands)
  `'$(Byte)',`;
}