//~ Tables
@table(Name, Path)
S_Types:
{
 { "asm" "embedded_fundamentals" }
 { "c"   "c_fundamentals"        }
}

@table(Name)
S_Config:
{
 { "11" }
}

//~ Data
//- S_Types 
@data_enum("type_kind")
TypeKindEnum:
{
 @expand(S_Types)
  ```Type_$(Name),
 ```;
 `Type_Count`;
}

@data_table("str8")
TypeStrings:
{
 @expand(S_Types) @strings
  ```{$(Name)},
 ```;
}

@data_table("str8")
TypePaths:
{
 @expand(S_Types) @strings
  ```{$(Path)},
 ```;
}

//- Config 
@data_table("str8")
ConfigTable:
{
 @expand(S_Config) @strings
  ```{$(Name)},
 ```;
}

//- Templates 
@table(Code)
AsmSampleCode:
{
 {
  """$NOMOD51
   
   ;~ Defines
   $include "aducgd1def.asm"
   
   ;~ Inits
   .org 0x0000
   
   ;~ EntryPoint
   mov sp, #0x7F
  
  loop: 
  
  ljmp loop
   
   ;~ Libraries
   $include "aducgd1inc.asm"
   
   end
   """;
   "};";
 }
}

@table(Code)
CSampleCode:
{
 {
  """
#define _CRT_SECURE_NO_WARNINGS 1
#include <stdio.h>
  
  int main(int ArgCount, char **Args)
  {
   
   return 0;
  }
  
  """;
   "};";
 }
}


@data
CSample:
{
 @expand(CSampleCode) @strings @cstring_lit
  `str8 CTemplateText = {$(Code)};`;
}

@data
AsmSample:
{
 @expand(AsmSampleCode) @strings @cstring_lit
  `str8 AsmTemplateText = {$(Code)};`;
}