
version(2);
project_name = "editor";

patterns = 
{
 "*.c",
 "*.cu",
 "*.cpp",
 "*.h",
 "*.m",
 "*.bat",
 "*.sh",
 "*.mdesk",
 "*.4coder",
 "*.glsl",
 "*.txt",
 "*.asm",
};

blacklist_patterns = 
{
 ".*",
 "gl_core_3_3_debug.h",
 "gl_core_4_5_debug.h",
 "archived",
};

paths = 
{
 { .path = ".",            .recursive = false, .relative = true, },
 { .path = "code",         .recursive = false, .relative = true, },
 { .path = "code/base",    .recursive = true,  .relative = true, },
 { .path = "code/lib",     .recursive = true,  .relative = true, },
 { .path = "code/shaders", .recursive = true,  .relative = true, },
 { .path = "code/rl/",     .recursive = true,  .relative = true, },
 { .path = "code/cling/",  .recursive = true, .relative = true, },
 //{ .path = "code/muze/",        .recursive = true,  .relative = true, },
 //{ .path = "code/editor/",      .recursive = true,  .relative = true, },
 { .path = "code/school/",      .recursive = true,  .relative = true, },
 //{ .path = "code/compenhance/", .recursive = true,  .relative = true, },
 //{ .path = "code/wsdcom/",      .recursive = true,  .relative = true, },
 { .path = "code/lsd/",         .recursive = true,  .relative = true, },
};

load_paths =
{
 .win = paths,
 .linux = paths,
 .mac = paths,
};

commands =
{
 .build = 
 {
  .out = "*compilation*", 
  .linux = "./code/build.sh norebuild -Meta -LSD",
  .win = ".\\code\\build.bat -Meta -LSD",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .build_m51 = 
 {
  .out = "*compilation*", 
  .linux = "./code/build.sh norebuild -Meta -M51",
  .win = ".\\code\\build.bat -Meta -M51",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .run = 
 {
  .out = "*compilation*", 
  .linux = "./build/editor",
  .win = "raddbg.exe --ipc run",
  .save_dirty_files = false,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .cling = 
 {
  .out = "*compilation*", 
  .linux = "./build/cling",
  .win = ".\build\cling.exe",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .raddbg_kill = 
 {
  .out = "*compilation*", 
  .linux = "sh ./code/test.sh",
  .win = "raddbg.exe --ipc kill_all",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
};

fkey_command =
{
 .F1 = "build",
 .F2 = "run",
 .F3 = "cling",
 .F5 = "raddbg_kill",
};
