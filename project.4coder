
version(2);
project_name = "editor";

patterns = 
{
 "*.c",
 "*.cu",
 "*.cpp",
 "*.h",
 "*.m",
 "*.bat",
 "*.sh",
 "*.mdesk",
 "*.4coder",
 "*.glsl",
 "*.txt",
 "*.asm",
};

blacklist_patterns = 
{
 ".*",
 "gl_core_3_3_debug.h",
 "gl_core_4_5_debug.h",
 "archived",
};

paths = 
{
 //- Libs
 { .path = ".",            .recursive = false, .relative = true, },
 { .path = "code",         .recursive = false, .relative = true, },
 { .path = "code/base",    .recursive = true,  .relative = true, },
 { .path = "code/lib",     .recursive = true,  .relative = true, },
 { .path = "code/rl/",     .recursive = true,  .relative = true, },
 { .path = "code/cling/",  .recursive = true,  .relative = true, },
 
 //- Targets
 { .path = "code/muze/",          .recursive = true,  .relative = true, },
 //{ .path = "code/wordled/",       .recursive = true,  .relative = true, },
 //{ .path = "code/editor/",        .recursive = true,  .relative = true, },
 //{ .path = "code/compenhance/",   .recursive = true,  .relative = true, },
 //{ .path = "code/wsdcom/",        .recursive = true,  .relative = true, },
 //{ .path = "code/lsd/",           .recursive = true,  .relative = true, },
 //{ .path = "code/pp/",            .recursive = true,  .relative = true, },
 //{ .path = "code/school/sampler", .recursive = true,  .relative = true, },
};

load_paths =
{
 .win = paths,
 .linux = paths,
 .mac = paths,
};

commands =
{
 .build_wsdcom = 
 {
  .out = "*compilation*", 
  .win = ".\\code\\build.bat -WSD -compile -copy",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .build_aduc = 
 {
  .out = "*compilation*", 
  .linux = "./code/build.sh -Aduc",
  .win = ".\\code\\build.bat -Aduc",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .build_muze = 
 {
  .out = "*compilation*", 
  .linux = "./code/build.sh -Muze",
  .win = ".\\code\\build.bat -Muze",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .build_wordled = 
 {
  .out = "*compilation*", 
  .linux = "./code/build.sh -Wordled",
  .win = ".\\code\\build.bat -Wordled",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .build_editor = 
 {
  .out = "*compilation*", 
  .linux = "./code/build.sh -Editor",
  .win = ".\\code\\build.bat -Editor",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .build_lsd = 
 {
  .out = "*compilation*", 
  .linux = "./code/build.sh -LSD",
  .win = ".\\code\\build.bat -LSD",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .build_school = 
 {
  .out = "*compilation*", 
  .linux = "./code/build.sh -School",
  .win = ".\\code\\build.bat -School",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .build_sampler = 
 {
  .out = "*compilation*", 
  .linux = "./code/build.sh -Sampler",
  .win = ".\\code\\build.bat -Sampler",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .build_pp = 
 {
  .out = "*compilation*", 
  .linux = "./code/build.sh -PP",
  .win = ".\\code\\build.bat -PP",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .build_haversine_processor = 
 {
  .out = "*compilation*", 
  .linux = "./code/build.sh -HaversineProcessor",
  .win = ".\\code\\build.bat -HaversineProcessor",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .build_haversine_generator = 
 {
  .out = "*compilation*", 
  .linux = "./code/build.sh -HaversineGenerator",
  .win = ".\\code\\build.bat -HaversineGenerator",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .build_last_sample = 
 {
  .out = "*compilation*", 
  .linux = "./build/sampler -last -compile",
  .win = ".\\build\\sampler -last -compile",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 
 .run = 
 {
  .out = "*compilation*", 
  .win = "raddbg.exe --ipc run",
  .save_dirty_files = false,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .cling = 
 {
  .out = "*compilation*", 
  .linux = "./build/cling",
  .win = ".\build\cling.exe",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
 .raddbg_kill = 
 {
  .out = "*compilation*", 
  .linux = "sh ./code/test.sh",
  .win = "raddbg.exe --ipc kill_all",
  .save_dirty_files = true,
  .footer_panel = false,
  .cursor_at_end = false,
 },
};

fkey_command =
{
 .F1 = "build_muze",
 .F2 = "run",
 .F3 = "cling",
 .F5 = "raddbg_kill",
};
